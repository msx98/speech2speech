+bool server_realtime_slot::input_rewind(const llama_tokens & target) {
+    if (target.size() >= (size_t) n_ctx) {
+        return fail("the text input does not fit in the context", ERROR_TYPE_EXCEED_CONTEXT_SIZE);
+    }
+    size_t common = 0;
+    while (common < text_history.size() && common < target.size() && text_history[common] == target[common]) {
+        common++;
+    }
+    if (common < text_history.size()) {
+        auto memory = llama_get_memory(ctx);
+        // Recurrent models may not support suffix removal. Replay from the start in that case.
+        if (!llama_memory_seq_rm(memory, seq_id, (llama_pos) common, -1)) {
+            if (!llama_memory_seq_rm(memory, seq_id, -1, -1)) {
+                return fail("cannot reset the revised text input");
+            }
+            common = 0;
+        }
+        text_history.resize(common);
+        n_past = (llama_pos) common;
+    }
+    return true;
+}
+
+bool server_realtime_slot::input_step() {
+    if (!input_rewind(input_target)) {
+        return false;
+    }
+    const int32_t count = (int32_t) std::min<size_t>(llama_n_batch(ctx), input_target.size() - text_history.size());
+    const int64_t start = ggml_time_us();
+    if (count > 0 && !decode(input_target.data() + text_history.size(), nullptr, count, false)) {
+        return false;
+    }
+    input_pending = text_history.size() < input_target.size();
+    auto res = std::make_unique<server_task_result_realtime>();
+    res->id = id_task;
+    res->index = index;
+    res->input_prefill = true;
+    res->input_finished = !input_pending;
+    res->input_revision = input_revision;
+    res->input_batch_tokens = count;
+    res->input_total_tokens = n_past;
+    res->input_batch_start_us = start;
+    res->input_batch_end_us = ggml_time_us();
+    queue_results.send(std::move(res));
     return true;
 }
